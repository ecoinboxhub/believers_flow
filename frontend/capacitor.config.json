{
  "appId": "com.believersguidelite.app",
  "appName": "BelieversFlow",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "ios": {
    "contentInset": "always",
    "preferredContentMode": "mobile",
    "allowsLinkPreview": true,
    "scrollEnabled": true,
    "minVersion": "15.0"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_believersflow",
      "iconColor": "#b8860b",
      "sound": "alarm.ogg"
    }
  }
}
